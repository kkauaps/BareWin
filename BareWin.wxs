<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="BareWin" Manufacturer="kkauaps" Version="0.3.2" UpgradeCode="6B2E3F4A-1C5D-4E8F-9A0B-7C1D2E3F4A5B" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="Versï¿½o mais nova jï¿½ instalada." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="app.ico" SourceFile="src\BareWin\app.ico" /><Property Id="ARPPRODUCTICON" Value="app.ico" />
    <StandardDirectory Id="ProgramFiles64Folder"><Directory Id="INSTALLFOLDER" Name="BareWin">
      <Component><File Source="out\BareWin.exe" KeyPath="yes" /></Component></Directory></StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Component Id="Sc" Guid="*"><Shortcut Name="BareWin" Target="[INSTALLFOLDER]BareWin.exe" Icon="app.ico" />
      <RegistryValue Root="HKCU" Key="Software\BareWin" Name="sc" Value="1" KeyPath="yes" /></Component></StandardDirectory>
  </Package>
</Wix>
